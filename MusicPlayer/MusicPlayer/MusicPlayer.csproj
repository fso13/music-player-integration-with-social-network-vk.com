<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>MusicPlayer</RootNamespace>
    <AssemblyName>MusicPlayer</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <ApplicationIcon />
    <StartupObject />
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="alglibnet2">
      <HintPath>..\alglibnet2.dll</HintPath>
    </Reference>
    <Reference Include="Bass.Net">
      <HintPath>..\Bass.Net.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="bass.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Image\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="domain\vk\**\*.cs" />
    <Compile Remove="domain\last.fm\**\*.cs" />
    <Compile Remove="Properties\Resources.Designer.cs" />
    <Compile Remove="Properties\Settings.Designer.cs" />
    <EmbeddedResource Remove="Properties\Resources.resx" />
    <Page Remove="UserControl1.xaml" />
    <Page Remove="Simple Styles.xaml" />
    <Page Remove="Properties\DesignTimeResources.xaml" />
  </ItemGroup>
</Project>
